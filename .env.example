# --- Bridge HTTP ---
# Host process: 127.0.0.1 so openresty on same host can proxy_pass http://127.0.0.1:8787
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Optional webhook/API token. Empty = open (same-host / reverse-proxy OK).
BRIDGE_WEBHOOK_SECRET=

# --- wechat-robot-client（出站发消息）---
WECHAT_CLIENT_BASE_URL=http://client_xTVn5dQNV3zQqjCD:9000
WECHAT_CLIENT_API_TOKEN=

# --- 触发策略 ---
AI_TRIGGER=
IGNORE_SELF=true
TEXT_ONLY=true

# --- Local dsh handoff (sessions show in dsh web) ---
# echo | sdk
AGENT_MODE=sdk
# Absolute dsh CLI; empty lets modern sdk-client resolve @deepseek-ai/dsh
DSH_BIN=/usr/local/bin/dsh
# MUST be the same home as `dsh web` so chats appear in the Web UI.
# Default when unset: ~/.dsh  (on home: /root/.dsh)
DSH_HOME=/root/.dsh
DSH_PROFILE=sdk
# Leave DSH_PROVIDER / DSH_MODEL empty — bridge reads agent-default-model from
# $DSH_HOME/profiles/{sdk,web}/cordis.patch.yml. Do NOT point the bridge at
# DeepSeek HTTP; dsh owns credentials + model route.
# DSH_PROVIDER=
# DSH_MODEL=
# Workspace cwd recorded on SDK-created sessions
# AGENT_CWD=/opt/dsh-wechat-bridge
SESSION_SCOPE=chat_sender
