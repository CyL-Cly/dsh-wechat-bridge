# --- Bridge HTTP ---
# Host process: 127.0.0.1 so openresty on same host can proxy_pass http://127.0.0.1:8787
# Inside Docker: set BRIDGE_HOST=0.0.0.0 and publish "127.0.0.1:8787:8787"
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# REQUIRED webhook/API token (no-token → auto-generated into .env on first start).
# Also accepted as ACCESS_TOKEN. Headers: X-Bridge-Secret | X-Webhook-Secret | Authorization: Bearer
BRIDGE_WEBHOOK_SECRET=
# ACCESS_TOKEN=

# --- wechat-robot-client（出站发消息）---
# Docker 同网时常用 http://client_<ROBOT_CODE>:9000（当前栈 WECHAT_CLIENT_PORT=9000）
WECHAT_CLIENT_BASE_URL=http://client_xTVn5dQNV3zQqjCD:9000
# 若开启了系统设置 API Token，填到这里（Header: Authorization / X-API-Token 视版本）
WECHAT_CLIENT_API_TOKEN=

# --- 触发策略（对齐内置 AI：群需触发词；私聊默认全开）---
# 为空则群聊也全量转发（不推荐）
AI_TRIGGER=
# 忽略机器人自己发出的消息（query robot_wxid）
IGNORE_SELF=true
# 只处理文本 MsgType=1
TEXT_ONLY=true

# --- DeepSeek Harness SDK ---
# echo | sdk
AGENT_MODE=sdk
# 本地源码构建后的 dsh 可执行；空则让 sdk-client 解析 npm 的 @deepseek-ai/dsh
DSH_BIN=
DSH_HOME=./.dsh-home
DSH_PROFILE=sdk
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
# DeepSeek / 兼容 API Key（dsh credentials 也可在 Web UI 里配）
DEEPSEEK_API_KEY=
# 可选 patch（绝对或相对 bridge 根目录）
DSH_PATCHES=./plugin/cordis.yml
# 会话：按 from_wxid(+sender) 复用同一个 dsh session
SESSION_SCOPE=chat_sender
