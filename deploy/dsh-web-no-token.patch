+/**
+ * Local / reverse-proxy deployments: skip launch-token + cookie gate for the Web UI.
+ * Enable with DSH_WEB_NO_TOKEN=1 (or DSH_BROWSER_AUTH=disabled).
+ * OpenResty can proxy_pass to the bind port without ?token= from `dsh web` stdout.
+ */
+function webNoTokenEnabled(): boolean {
+  const noToken = (process.env.DSH_WEB_NO_TOKEN ?? '').trim().toLowerCase()
+  if (['1', 'true', 'yes', 'on'].includes(noToken)) return true
+  const browserAuth = (process.env.DSH_BROWSER_AUTH ?? '').trim().toLowerCase()
+  return ['disabled', 'off', 'none', '0', 'false'].includes(browserAuth)
+}
